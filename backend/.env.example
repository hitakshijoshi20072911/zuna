# Copy to .env for local use (never commit the real file).
ZUNA_TOKEN_SECRET=change-me-to-a-long-random-string
# DATABASE_URL=postgresql://user:pass@host:5432/dbname   # omit to use local SQLite
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
